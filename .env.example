# Пример переменных окружения. Скопируйте в .env и подставьте свои значения.
# Секреты в git не коммитим — Twelve-Factor: конфиг только через окружение.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,webserver,testserver

# Локально можно не задавать: Django возьмёт SQLite.
# На Render эту переменную выдаёт PostgreSQL-сервис.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# DSN коллектора ошибок (Bugsink / совместимый Sentry SDK).
# Пустое значение — события не отправляются. Секрет, в git не коммитить.
# SENTRY_DSN=https://key@your-instance.bugsink.com/1
